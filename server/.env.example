# Anthropic (optional - for fallback AI when cache/local miss)
ANTHROPIC_API_KEY=sk-ant-...

# Upstash Vector (optional - semantic cache)
UPSTASH_VECTOR_URL=https://...
UPSTASH_VECTOR_TOKEN=...

# Upstash Redis (required for workers & dashboard)
UPSTASH_REDIS_URL=https://...
UPSTASH_REDIS_TOKEN=...

# Server
PORT=3000
