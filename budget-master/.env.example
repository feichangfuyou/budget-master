# Neon PostgreSQL
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/budgetmaster?sslmode=require

# Upstash Vector (semantic cache) - https://console.upstash.com
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Upstash Redis (cache + metrics) - https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Anthropic (AI chat)
ANTHROPIC_API_KEY=

# Optional: OpenAI for embeddings (vector cache)
OPENAI_API_KEY=

# Server
PORT=3000
NODE_ENV=development
